index 00000000..51c6f882
--- /dev/null
+++ b/apps/server/src/usage/antigravityHubLimits.ts
@@ -0,0 +1,76 @@
+import type { ServerProviderUsageWindow } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+
+const Bucket = Schema.Struct({
+  bucketId: Schema.NonEmptyString,
+  disabled: Schema.optional(Schema.Boolean),
+  window: Schema.optional(Schema.String),
+  displayName: Schema.optional(Schema.String),
+  description: Schema.optional(Schema.String),
+  remainingFraction: Schema.optional(Schema.Number),
+  resetTime: Schema.optional(Schema.String),
+});
+const Summary = Schema.Struct({
+  groups: Schema.optional(
+    Schema.Array(
+      Schema.Struct({
+        displayName: Schema.optional(Schema.String),
+        buckets: Schema.optional(Schema.Array(Bucket)),
+      }),
+    ),
+  ),
+  buckets: Schema.optional(Schema.Array(Bucket)),
+});
+const decodeSummary = Schema.decodeUnknownEffect(Schema.fromJsonString(Summary));
+
+function familyLabel(bucketId: string, groupName: string | undefined): string {
+  if (bucketId.startsWith("gemini-argon-")) return groupName || "Gemini Argon";
+  if (bucketId.startsWith("gemini-carbon-")) return groupName || "Gemini Carbon";
+  if (bucketId.startsWith("gemini-")) return "Gemini";
+  if (bucketId.startsWith("3p-")) return "Claude & GPT (shared)";
+  return groupName || bucketId;
+}
+
+function quotaWindows(summary: typeof Summary.Type, requestedAt: number) {
+  const windows = new Map<string, ServerProviderUsageWindow>();
+  const groups = summary.groups?.some((group) => group.buckets?.length)
+    ? summary.groups
+    : [{ buckets: summary.buckets, displayName: undefined }];
+  for (const group of groups ?? []) {
+    for (const bucket of group.buckets ?? []) {
+      const remaining = bucket.remainingFraction;
+      if (bucket.disabled || remaining === undefined || !Number.isFinite(remaining)) continue;
+      const weekly = bucket.window === "weekly";
+      const session = bucket.window === "5h";
+      const windowDurationMins = weekly ? 7 * 24 * 60 : session ? 5 * 60 : undefined;
+      const reset = bucket.resetTime ? DateTime.make(bucket.resetTime) : Option.none();
+      // An untouched bucket can return a moving end time instead of an actual reset.
+      const untouched =
+        remaining === 1 &&
+        bucket.description === undefined &&
+        windowDurationMins !== undefined &&
+        Option.isSome(reset) &&
+        Math.abs(DateTime.toEpochMillis(reset.value) - requestedAt - windowDurationMins * 60_000) <=
+          60_000;
+      const family = familyLabel(bucket.bucketId, group.displayName?.trim());
+      const period = weekly ? "Weekly" : session ? "5-hour" : bucket.displayName?.trim() || "Quota";
+      windows.set(bucket.bucketId, {
+        id: bucket.bucketId,
+        label: `${family} · ${period}`,
+        kind: weekly ? "weekly" : session ? "session" : "other",
+        usedPercent: (1 - Math.max(0, Math.min(1, remaining))) * 100,
+        ...(Option.isSome(reset) && !untouched
+          ? { resetsAt: DateTime.formatIso(reset.value) }
+          : {}),
+        ...(windowDurationMins === undefined ? {} : { windowDurationMins }),
+      });
+    }
+  }
+  return [...windows.values()];
+}
+
+export const readAntigravitySummaryWindows = (body: string, requestedAt: number) =>
+  decodeSummary(body).pipe(Effect.map((summary) => quotaWindows(summary, requestedAt)));
